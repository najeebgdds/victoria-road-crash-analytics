            <column caption='Deg Urban Name' datatype='string' name='[deg_urban_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;LARGE_PROVINCIAL_CITIES&quot;' value='Large Provincial Cities' />
                <alias key='&quot;MELB_URBAN&quot;' value='Melbourne Urban' />
                <alias key='&quot;MELBOURNE_CBD&quot;' value='Melboure CBD' />
                <alias key='&quot;RURAL_VICTORIA&quot;' value='Rural Victoria' />
                <alias key='&quot;SMALL_CITIES&quot;' value='Small Cities' />
                <alias key='&quot;SMALL_TOWNS&quot;' value='Small Towns' />
                <alias key='&quot;TOWNS&quot;' value='Towns' />
              </aliases>
            </column>
            <column-instance column='[Calculation_370702564489023488]' derivation='None' name='[none:Calculation_370702564489023488:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.0gpkejb080zb9u15mmuce07qblcx].[ctd:accident_no:qk]' field-type='quantitative' max='129170' min='0' range-type='fixed' scope='cols' type='space' />
            <format attr='title' class='0' field='[federated.0gpkejb080zb9u15mmuce07qblcx].[ctd:accident_no:qk]' scope='cols' value='Crashes' />
