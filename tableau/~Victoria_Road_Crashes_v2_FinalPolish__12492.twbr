      <table>
        <view>
          <datasources>
            <datasource caption='vw_road_user_analysis' name='federated.1cunh7e1iep5rs130h3tj0cx1435' />
          </datasources>
          <datasource-dependencies datasource='federated.1cunh7e1iep5rs130h3tj0cx1435'>
            <column caption='Age Group (Dashboard)' datatype='string' name='[Calculation_539869034296414208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [age_group] = &quot;16-17&quot; THEN &quot;Learners (16-17)&quot;&#13;&#10;&#13;&#10;ELSEIF [age_group] = &quot;18-21&quot; THEN &quot;Young Drivers (18-21)&quot;&#13;&#10;&#13;&#10;ELSEIF [age_group] = &quot;22-25&quot; THEN &quot;Early Experience (22-25)&quot;&#13;&#10;&#13;&#10;ELSEIF [age_group] = &quot;26-29&quot; THEN &quot;Experienced Drivers (26-29)&quot;&#13;&#10;&#13;&#10;ELSEIF [age_group] = &quot;30-39&quot; THEN &quot;Established Drivers (30-39)&quot;&#13;&#10;&#13;&#10;ELSEIF [age_group] = &quot;40-49&quot; THEN &quot;Mid-Career Drivers (40-49)&quot;&#13;&#10;&#13;&#10;ELSEIF [age_group] = &quot;50-59&quot; THEN &quot;Senior Drivers (50-59)&quot;&#13;&#10;&#13;&#10;ELSEIF [age_group] = &quot;60-64&quot;&#13;&#10;   OR [age_group] = &quot;65-69&quot;&#13;&#10;THEN &quot;Veteran Drivers (60-69)&quot;&#13;&#10;&#13;&#10;ELSEIF [age_group] = &quot;70-74&quot;&#13;&#10;   OR [age_group] = &quot;75-79&quot;&#13;&#10;   OR [age_group] = &quot;80-84&quot;&#13;&#10;   OR [age_group] = &quot;85-89&quot;&#13;&#10;   OR [age_group] = &quot;90+&quot;&#13;&#10;THEN &quot;Lifetime Drivers (70+)&quot;&#13;&#10;&#13;&#10;ELSE [age_group]&#13;&#10;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;70+&quot;' value='Lifetime Drivers 70+' />
              </aliases>
            </column>
            <column caption='Age Group' datatype='string' name='[age_group]' role='dimension' type='nominal' />
            <column-instance column='[person_id]' derivation='Count' name='[cnt:person_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_539869034296414208]' derivation='None' name='[none:Calculation_539869034296414208:nk]' pivot='key' type='nominal' />
            <column caption='Person Id' datatype='string' name='[person_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1cunh7e1iep5rs130h3tj0cx1435].[none:Calculation_539869034296414208:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_539869034296414208:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Calculation_539869034296414208:nk]' member='&quot;0-4&quot;' />
                <groupfilter function='member' level='[none:Calculation_539869034296414208:nk]' member='&quot;13-15&quot;' />
                <groupfilter function='member' level='[none:Calculation_539869034296414208:nk]' member='&quot;5-12&quot;' />
