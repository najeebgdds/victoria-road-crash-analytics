        </aliases>
      </column>
      <column caption='Urban vs Regional' datatype='string' name='[Calculation_370702564489023488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [deg_urban_name] = &quot;MELB_URBAN&quot; THEN&#13;&#10;    &quot;Melbourne Urban&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Regional Victoria&quot;&#13;&#10;END' />
      </column>
      <column caption='lowercaselga' datatype='string' name='[Calculation_370702564490039297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='PROPER(LOWER([lga_name]))' />
      </column>
      <column caption='Average Daily Crashes' datatype='real' name='[Calculation_893683072617033728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([accident_no]) / COUNTD([full_date])' />
