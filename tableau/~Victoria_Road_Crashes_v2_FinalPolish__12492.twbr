      <aliases enabled='yes' />
      <column caption='Commercial Vehicle Crash Share' datatype='real' name='[Calculation_269653053489672192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([accident_no])&#13;&#10;/&#13;&#10;197249' />
      </column>
      <column caption='Heavy Vehicle Crash' datatype='string' name='[Calculation_513973332909178880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vehicle_type_desc]=&apos;Heavy Vehicle (Rigid) &gt; 4.5 Tonnes&apos;&#13;&#10;THEN [accident_no]&#13;&#10;END' />
      </column>
      <column caption='Light Commercial Crash' datatype='string' name='[Calculation_513973332909699073]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vehicle_type_desc]=&apos;Light Commercial Vehicle (Rigid) &lt;= 4.5 Tonnes GVM&apos;&#13;&#10;THEN [accident_no]&#13;&#10;END' />
      </column>
      <column caption='Bus Coach Crash' datatype='string' name='[Calculation_513973332910637058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vehicle_type_desc]=&apos;Bus/Coach&apos;&#13;&#10;OR [vehicle_type_desc]=&apos;Mini Bus(9-13 seats)&apos;&#13;&#10;THEN [accident_no]&#13;&#10;END' />
      </column>
      <column caption='Most Common Commercial Vehicle' datatype='string' name='[Calculation_513973332911202307]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF FIRST()=0 THEN ATTR([vehicle_type_desc]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
