      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0gpkejb080zb9u15mmuce07qblcx].[__tableau_internal_object_id__].[cnt:vw_exective_overview.csv_51EC83F7348F45919B9A00B9DA96E008:qk]&quot;' value='Total Crashes' />
          <alias key='&quot;[federated.0gpkejb080zb9u15mmuce07qblcx].[sum:no_persons_inj_2:qk]&quot;' value='Total Serious Injuries' />
